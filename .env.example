# ── كوب — backend ──────────────────────────────────────────────────────────
# cp .env.example .env  and fill in. Nothing here has a deployment default on
# purpose: a missing value must fail loudly, not borrow another shop's.

# Core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
VERTICAL=cafe

# The SHOP's timezone. Every "today" in every report depends on this.
TIME_ZONE=Asia/Hebron
LANGUAGE_CODE=ar

# كوب closes late. Set this to the hour the till is cashed up, so a sale at
# 01:30 counts against the night before, not the next morning.
BUSINESS_DAY_START_HOUR=4

# Database — local Postgres now, Neon later (use the POOLED endpoint on Neon)
DATABASE_URL=postgres://coop:coop@localhost:5432/coop
DB_CONN_MAX_AGE=60

# Redis — cache, rate limits, Celery broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=0
CACHE_TTL=300

# Clerk — customer auth (Google + Facebook). Staff sign in with Django users.
#   CLERK_JWT_KEY  = the PEM public key from Clerk → API keys → "Show JWT key".
#                    Setting it makes verification NETWORKLESS: no round-trip to
#                    Clerk on the POS hot path. Do not skip it.
#   CLERK_AUTHORIZED_PARTIES = your exact frontend origins, comma separated.
#                    Without it a token minted for any other Clerk app can be
#                    replayed against this API.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=
# Which tenant a Clerk signup belongs to.
CLERK_STORE_SLUG=koup

# Loyalty — tune with the owner against real margin before launch
BEANS_PER_ILS=0.2
BEAN_PRICE_MULTIPLIER=3.33
SIGNUP_BONUS_BEANS=5
BEAN_EXPIRY_MONTHS=6

# Web Push (VAPID) — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hamza.sabri@freightos.com

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
LOG_LEVEL=INFO

# Admin chrome
ADMIN_SITE_BRAND=كوب
ADMIN_SITE_HEADER=كوب — لوحة التحكم
ADMIN_SITE_TITLE=كوب
